# Copy to .env and fill in real values. Never commit .env.

# --- Application ---
APP_NAME=ICMR Neurodevelopment Dashboard API
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- CORS (comma-separated origins allowed to call this API) ---
# In production, set this to the deployed frontend's URL (comma-separated
# with http://localhost:5173 if you also want local dev access to a prod backend).
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- REDCap (production source of truth — live) ---
# Required. Never commit real values.
REDCAP_API_URL=
REDCAP_API_TOKEN=

# Optional bookkeeping only — the REDCap client does not require it.
REDCAP_PROJECT_ID=
