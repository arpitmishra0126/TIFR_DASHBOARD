# Copy to .env and fill in real values. Never commit .env.

# --- Application ---
APP_NAME=ICMR Neurodevelopment Dashboard API
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- CORS (comma-separated origins allowed to call this API) ---
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- PostgreSQL (application's normalized data/cache layer) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/icmr_neurodev

# --- REDCap (production source of truth — NOT yet connected) ---
# Supply these only when live REDCap integration is authorized.
REDCAP_API_URL=
REDCAP_API_TOKEN=
REDCAP_PROJECT_ID=
